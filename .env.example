# ============================================
# Emaar Libya ERP - Environment Configuration
# ============================================

# Application
APP_NAME=Emaar Libya ERP
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-in-production-use-random-string

# Database
DATABASE_URL=sqlite:///data/emaar_erp.db
# DATABASE_URL=postgresql://user:password@localhost:5432/emaar_erp

# Company Defaults
DEFAULT_COUNTRY=Libya
DEFAULT_CURRENCY=LYD
DEFAULT_LANGUAGE=ar
DEFAULT_TIMEZONE=Africa/Tripoli

# Backup
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Paths
ASSETS_DIR=assets
TEMPLATES_DIR=assets/templates
STAMPS_DIR=assets/stamps
SIGNATURES_DIR=assets/signatures
FONTS_DIR=assets/fonts
